{
  "name": "event-horizon",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-based 3D flight and space simulator, built one system at a time.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "server": "tsx --env-file-if-exists=.env server/main.ts",
    "server:dev": "tsx watch --env-file-if-exists=.env server/main.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.24",
    "@colyseus/sdk": "^0.18.9",
    "@colyseus/ws-transport": "^0.18.4",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.182.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.182.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
