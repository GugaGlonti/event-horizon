# Public browser configuration; never put secrets in VITE_ values.
VITE_MULTIPLAYER_URL=ws://127.0.0.1:43172
VITE_INTERPOLATION_MS=100
# Development-only diagnostics and input/snapshot impairment. Ignored in production builds.
VITE_NETWORK_DEBUG=false
VITE_NETWORK_LATENCY_MS=0
VITE_NETWORK_JITTER_MS=0
VITE_NETWORK_LOSS_PERCENT=0

# Node authority. Loopback is the default; configure the host explicitly for a LAN deployment.
SERVER_HOST=127.0.0.1
SERVER_PORT=43172
SERVER_TICK_RATE=30
SERVER_SNAPSHOT_RATE=20
SERVER_CAPACITY=16
SERVER_RECONNECT_SECONDS=15
SERVER_RELEVANCE_METRES=6000
SERVER_DEBUG=false
